# Copie para .env.prod na raiz do repositório (não commitar).
# Senha do banco: só letras e números — @ : / quebram a URL.

DOMAIN=app.exemplo.com.br
ACME_EMAIL=ops@exemplo.com.br

POSTGRES_USER=veiculo
POSTGRES_PASSWORD=troqueEstaSenha
POSTGRES_DB=veiculo_scraper

# Pelo menos 32 caracteres, diferente do valor de desenvolvimento.
SESSION_SECRET=troque-por-32-caracteres-aleatorios

# Identificação do bot no User-Agent. Sem isso o coletor não sobe.
BOT_CONTACT_URL=https://exemplo.com.br/bot
BOT_CONTACT_EMAIL=contato@exemplo.com.br

# Vazio = o browser chama /api na mesma origem (Caddy). Só preencha se a API
# estiver em outro host.
NEXT_PUBLIC_API_URL=

# Hostnames internos da rede compartilhada do Dokploy.
# Se o serviço API tiver outro nome no Dokploy, use esse hostname aqui.
API_URL=http://api:3001
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://veiculo:troqueEstaSenha@postgres:5432/veiculo_scraper
