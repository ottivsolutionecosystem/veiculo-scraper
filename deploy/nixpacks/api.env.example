# Dokploy — serviço api (NIXPACKS_CONFIG_FILE=deploy/nixpacks/api.toml)
# Copie o conteúdo nas variáveis de ambiente da aplicação. Não commitar segredos.
#
# Hostnames (postgres, redis, api) = nomes DNS na rede compartilhada do Dokploy.
# Senha do banco: só letras e números — @ : / quebram a URL se não escapados.

NODE_ENV=production
PORT=3001

DATABASE_URL=postgresql://veiculo:troqueEstaSenha@postgres:5432/veiculo_scraper
REDIS_URL=redis://redis:6379

# Pelo menos 32 caracteres, diferente do valor de desenvolvimento.
SESSION_SECRET=troque-por-32-caracteres-aleatorios

# Origem pública do front (CORS / cookies de sessão).
WEB_ORIGIN=https://app.exemplo.com.br

# Opcional — só no primeiro deploy, se quiser outro admin inicial (seed idempotente).
# SEED_ADMIN_LOGIN=admin
# SEED_ADMIN_PASSWORD=troqueEstaSenha
# SEED_ADMIN_NAME=Administrador
# SEED_ADMIN_ROLE=master
