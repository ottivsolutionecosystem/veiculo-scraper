# Dokploy — serviço collector (NIXPACKS_CONFIG_FILE=deploy/nixpacks/collector.toml)
# Só o coletor Python — use se NÃO roda o coletor dentro do work.
# Copie o conteúdo nas variáveis de ambiente da aplicação. Não commitar segredos.

PYTHONUNBUFFERED=1

DATABASE_URL=postgresql://veiculo:troqueEstaSenha@postgres:5432/veiculo_scraper

# Obrigatório (collector-loop.sh aborta sem estas).
BOT_CONTACT_URL=https://app.exemplo.com.br/bot
BOT_CONTACT_EMAIL=contato@exemplo.com.br

# Opcional
# BOT_NAME=OttivBot
# BOT_VERSION=1.0
# PYTHON_BIN=/app/.venv/bin/python3
# COLLECTOR_HEARTBEAT=/tmp/collector-ok
