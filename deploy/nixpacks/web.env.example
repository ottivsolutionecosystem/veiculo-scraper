# Dokploy — serviço web (NIXPACKS_CONFIG_FILE=deploy/nixpacks/web.toml)
# Copie o conteúdo nas variáveis de ambiente da aplicação.
#
# Publique só o web na internet (domínio + HTTPS). A API fica na rede interna.

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Runtime: Server Components + proxy /api (app/api/[...path]).
# Use o hostname DNS EXATO do serviço api na rede do Dokploy
# (pode ser http://api:3001 ou http://crawler-api:3001 — veja o nome do serviço).
# Preferência; o painel também tenta crawler-api / api automaticamente.
API_URL=http://crawler-api:3001

# Vazio = o browser chama /api na mesma origem; o Next encaminha para API_URL.
NEXT_PUBLIC_API_URL=
