# Dokploy — serviço work (NIXPACKS_CONFIG_FILE=deploy/nixpacks/work.toml)
# Worker BullMQ + coletor Python no mesmo processo.
# Copie o conteúdo nas variáveis de ambiente da aplicação. Não commitar segredos.
#
# O worker importa apps/api/src/env.ts — precisa das mesmas variáveis obrigatórias da api.
# O coletor lê pedidos no Postgres; BOT_CONTACT_* vai no User-Agent do bot.

NODE_ENV=production

DATABASE_URL=postgresql://veiculo:troqueEstaSenha@postgres:5432/veiculo_scraper
REDIS_URL=redis://redis:6379
SESSION_SECRET=troque-por-32-caracteres-aleatorios
WEB_ORIGIN=https://app.exemplo.com.br

# Coletor no mesmo processo — defina BOT_CONTACT_* OU use collector separado:
COLLECTOR_ENABLED=false

# Se COLLECTOR_ENABLED não é false, BOT_CONTACT_* são obrigatórios no work.
#BOT_CONTACT_URL=https://app.exemplo.com.br/bot
#BOT_CONTACT_EMAIL=contato@exemplo.com.br

# Opcional — defaults do captacao_bot/config.py
# BOT_NAME=OttivBot
# BOT_VERSION=1.0

# Opcional — venv do Nixpacks já define PYTHON_BIN; só use se precisar forçar.
# PYTHON_BIN=/app/.venv/bin/python3
# COLLECTOR_HEARTBEAT=/tmp/collector-ok
# PYTHONUNBUFFERED=1
